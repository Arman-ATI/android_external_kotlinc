#!/usr/bin/env bash

# Based on scalac from the Scala distribution
# Copyright 2002-2011, LAMP/EPFL
# Copyright 2010-2021 JetBrains s.r.o. and Kotlin Programming Language contributors.
# Use of this source code is governed by the Apache 2.0 license that can be found in the license/LICENSE.txt file.

# Performance-optimized version with daemon support, parallel compilation, and better memory settings

# OS detection
cygwin=false
darwin=false
mingw=false
case "$(uname)" in
  CYGWIN*) cygwin=true ;;
  Darwin*) darwin=true ;;
  MINGW*) mingw=true ;;
esac

# Based on findScalaHome() from scalac script
findKotlinHome() {
    local source="${BASH_SOURCE[0]}"
    while [ -h "$source" ] ; do
        local linked="$(readlink "$source")"
        local dir="$(cd -P "$(dirname "$source")" && cd -P "$(dirname "$linked")" && pwd)"
        source="$dir/$(basename "$linked")"
    done
    (cd -P "$(dirname "$source")/.." && pwd)
}

findJavaVersion() {
    # Parse Java version to get major version number
    local java_cmd="${JAVACMD:=java}"
    
    # Handle potential spaces in Java path
    if $cygwin || $mingw; then
        java_cmd=$(cygpath --unix "$java_cmd")
    fi
    
    "$java_cmd" -version 2>&1 | grep -i version | head -n 1 | cut -d'"' -f2 | cut -d'.' -f1
}

# Find processor count for parallel compilation
getProcessorCount() {
    if [ -f /proc/cpuinfo ]; then
        grep -c ^processor /proc/cpuinfo
    elif $darwin; then
        sysctl -n hw.ncpu
    else
        echo 4  # Default if we can't detect
    fi
}

KOTLIN_HOME="$(findKotlinHome)"

# Path normalization for Windows
if $cygwin || $mingw; then
    # Convert paths for Java use
    [ -n "$KOTLIN_HOME" ] && KOTLIN_HOME=$(cygpath --windows "$KOTLIN_HOME")
    [ -n "$KOTLIN_BUILD_CACHE_DIR" ] && KOTLIN_BUILD_CACHE_DIR=$(cygpath --windows "$KOTLIN_BUILD_CACHE_DIR")
fi

# Performance-tuned default JVM options
if [ -z "$JAVA_OPTS" ]; then
    # Detect available memory and set heap accordingly (up to 4GB)
    if [ -f /proc/meminfo ]; then
        MEM_KB=$(grep MemTotal /proc/meminfo | awk '{print $2}')
        MEM_MB=$((MEM_KB / 1024))
        HEAP_SIZE=$((MEM_MB / 4))
        # Cap at 4GB
        [ "$HEAP_SIZE" -gt 4096 ] && HEAP_SIZE=4096
        # Minimum 1GB
        [ "$HEAP_SIZE" -lt 1024 ] && HEAP_SIZE=1024
    else
        # Default to 2GB if we can't detect
        HEAP_SIZE=2048
    fi
    
    JAVA_OPTS="-Xmx${HEAP_SIZE}M -Xms${HEAP_SIZE}M -XX:+UseParallelGC"
    
    # Add GC tuning for large projects
    JAVA_OPTS="$JAVA_OPTS -XX:+UseStringDeduplication -XX:StringTableSize=1000003"
    
    # Add class data sharing for faster startup
    JAVA_OPTS="$JAVA_OPTS -XX:+UseCompressedClassPointers -XX:+UseCompressedOops"
fi

# Configure incremental compilation (enabled by default)
[ -z "$KOTLIN_INCREMENTAL" ] && KOTLIN_INCREMENTAL=true

# Configure compiler daemon (enabled by default)
[ -z "$KOTLIN_DAEMON_ENABLED" ] && KOTLIN_DAEMON_ENABLED=true

# Configure parallel compilation threads
[ -z "$KOTLIN_COMPILER_THREADS" ] && KOTLIN_COMPILER_THREADS=$(getProcessorCount)

# Configure build cache
[ -z "$KOTLIN_BUILD_CACHE_DIR" ] && KOTLIN_BUILD_CACHE_DIR="$HOME/.kotlin/cache"
[ -n "$KOTLIN_BUILD_CACHE_DIR" ] && mkdir -p "$KOTLIN_BUILD_CACHE_DIR"

# Process arguments
declare -a java_args
declare -a kotlin_args

while [ $# -gt 0 ]; do
  case "$1" in
    -D*)
      java_args=("${java_args[@]}" "$1")
      shift
      ;;
    -J*)
      java_args=("${java_args[@]}" "${1:2}")
      if [ "x${1:2}" = "x" ]; then
        echo "error: empty -J argument"
        exit 1
      fi
      shift
      ;;
    *)
      kotlin_args=("${kotlin_args[@]}" "$1")
      shift
      ;;
  esac
done

# Find Java executable
if [ -z "$JAVACMD" -a -n "$JAVA_HOME" -a -x "$JAVA_HOME/bin/java" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
fi

# Apply performance options
if [ "$KOTLIN_INCREMENTAL" = true ]; then
    kotlin_args=("${kotlin_args[@]}" "-Xincremental")
fi

if [ "$KOTLIN_DAEMON_ENABLED" = true ]; then
    kotlin_args=("${kotlin_args[@]}" "-Xuse-daemon")
    
    # Add daemon worker heap configuration 
    if [ -n "$KOTLIN_DAEMON_WORKER_HEAP" ]; then
        kotlin_args=("${kotlin_args[@]}" "-Xdaemon-worker-jvm-options=-Xmx${KOTLIN_DAEMON_WORKER_HEAP}")
    fi
fi

if [ -n "$KOTLIN_COMPILER_THREADS" ]; then
    kotlin_args=("${kotlin_args[@]}" "-Xparallel-backend-threads=$KOTLIN_COMPILER_THREADS")
fi

if [ -n "$KOTLIN_BUILD_CACHE_DIR" ]; then
    kotlin_args=("${kotlin_args[@]}" "-Xbuild-cache-dir=$KOTLIN_BUILD_CACHE_DIR")
fi

declare -a kotlin_app

java_version="$(findJavaVersion)"
if [ "$java_version" -ge 9 ]; then
    # Add modules and reflection access for Java 9+
    java_args=("${java_args[@]}" "--add-opens" "java.base/java.util=ALL-UNNAMED")
    java_args=("${java_args[@]}" "--add-opens" "java.base/java.lang=ALL-UNNAMED")
    java_args=("${java_args[@]}" "--add-opens" "java.base/java.lang.reflect=ALL-UNNAMED")
    java_args=("${java_args[@]}" "--add-opens" "java.base/java.io=ALL-UNNAMED")
fi

if [ -n "$KOTLIN_RUNNER" ]; then
    java_args=("${java_args[@]}" "-Dkotlin.home=${KOTLIN_HOME}")
    kotlin_app=("${KOTLIN_HOME}/lib/kotlin-runner.jar" "org.jetbrains.kotlin.runner.Main")
else
    [ -n "$KOTLIN_COMPILER" ] || KOTLIN_COMPILER=org.jetbrains.kotlin.cli.jvm.K2JVMCompiler

    if [ "$java_version" -lt 13 ]; then
        java_args=("${java_args[@]}" "-noverify")
    fi

    declare additional_classpath=""
    if [ -n "$KOTLIN_TOOL" ]; then
        additional_classpath=":${KOTLIN_HOME}/lib/${KOTLIN_TOOL}"
    fi
    
    # Add custom classpath if specified
    if [ -n "$KOTLIN_CLASSPATH" ]; then
        additional_classpath="${additional_classpath}:${KOTLIN_CLASSPATH}"
    fi

    kotlin_app=("${KOTLIN_HOME}/lib/kotlin-preloader.jar" "org.jetbrains.kotlin.preloading.Preloader" "-cp" "${KOTLIN_HOME}/lib/kotlin-compiler.jar${additional_classpath}" $KOTLIN_COMPILER)
fi

# Print configuration if verbose mode is enabled
if [ "$KOTLIN_VERBOSE" = true ]; then
    echo "Kotlin compiler configuration:"
    echo "  KOTLIN_HOME: $KOTLIN_HOME"
    echo "  JAVA_OPTS: $JAVA_OPTS"
    echo "  Incremental compilation: $KOTLIN_INCREMENTAL"
    echo "  Daemon enabled: $KOTLIN_DAEMON_ENABLED"
    echo "  Compiler threads: $KOTLIN_COMPILER_THREADS"
    echo "  Build cache: $KOTLIN_BUILD_CACHE_DIR"
    echo "  Java version: $java_version"
fi

# Execute the Kotlin compiler
"${JAVACMD:=java}" $JAVA_OPTS "${java_args[@]}" -cp "${kotlin_app[@]}" "${kotlin_args[@]}"
